<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    ProtoCross's own compiler must never inherit the overflow behavior it is trying to
    define. Emitted code states its arithmetic behavior explicitly; see ProtoCross_Spec.md.
  -->
  <PropertyGroup>
    <CheckForOverflowUnderflow>false</CheckForOverflowUnderflow>
  </PropertyGroup>

  <!--
    The version has one home, the extension's package.json, which `npm version` moves with each pull
    request (docs/language-1-workflow.md). Every build reads it from there: the release, the server the
    extension stages, the tool package, and `dotnet run`. So the command line, the server and the
    package all report the number the extension is released under, and a build from source no longer
    calls itself 1.0.0. The manifest's own "version" is the only key of that name in it, so the first
    match is the right one. A -p:Version= on the command line still wins, as a global property does.
  -->
  <PropertyGroup Condition="Exists('$(MSBuildThisFileDirectory)editors/vscode/package.json')">
    <Version>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)editors/vscode/package.json')), '"version"\s*:\s*"([^"]+)"').Groups[1].Value)</Version>
  </PropertyGroup>

  <!--
    Only the command line is a package, the ProtoCross tool. The libraries are not published: the IR
    stays free to change (spec 30.22.2), so a library package would promise an API nobody has decided
    to keep.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
