<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ProtoCross.Projects</RootNamespace>
  </PropertyGroup>

  <!--
    A library of its own rather than part of Core, because reading a project means listing
    directories and matching globs against what is in them, and Core takes source text from its
    caller rather than going looking for it. The command line and the language server both reference
    this; Core references neither it nor its package.
  -->
  <ItemGroup>
    <ProjectReference Include="..\ProtoCross.Core\ProtoCross.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" />
  </ItemGroup>

</Project>
