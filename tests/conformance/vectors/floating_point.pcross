// Conformance vectors for IEEE 754 floating-point division.
//
// Unlike integer division, floating-point division by zero has a defined answer, so ProtoCross
// leaves it alone and no on_zero clause is allowed. The answer is an infinity or a NaN, and each
// vector expects it as the literal it is: __INF, -__INF or __NAN (spec 6.6). A NaN expectation is
// met by any NaN (spec 25.3), which is why what a NaN does in a comparison is pinned separately,
// by a predicate: an expectation cannot be used to ask about ==.

import proto "floating_point.proto";

extend FloatCase {
    // Every ordered comparison against a NaN is false, and so is equality, even with itself.
    fn nan_compares_false() -> bool {
        var q: double = numerator / denominator;
        return not (q < 0.0) and not (q > 0.0) and not (q == 0.0) and q != q;
    }

    fn quotient() -> double {
        return numerator / denominator;
    }

    fn narrow_quotient() -> float {
        return narrow_numerator / narrow_denominator;
    }
}

test FloatCase.quotient "dividing a positive value by zero yields positive infinity" {
    receiver {
        numerator = 1.0;
        denominator = 0.0;
    }

    expect return __INF;
}

test FloatCase.quotient "dividing a negative value by zero yields negative infinity" {
    receiver {
        numerator = -1.0;
        denominator = 0.0;
    }

    expect return -__INF;
}

test FloatCase.quotient "zero divided by zero yields NaN" {
    receiver {
        numerator = 0.0;
        denominator = 0.0;
    }

    expect return __NAN;
}

test FloatCase.nan_compares_false "every comparison against NaN is false" {
    receiver {
        numerator = 0.0;
        denominator = 0.0;
    }

    expect return true;
}

test FloatCase.quotient "double division is exact for a power of two" {
    receiver {
        numerator = 1.0;
        denominator = 4.0;
    }

    expect return 0.25;
}

test FloatCase.narrow_quotient "float division follows the same rules as double" {
    receiver {
        narrow_numerator = 0.0;
        narrow_denominator = 0.0;
    }

    expect return __NAN;
}

test FloatCase.narrow_quotient "float division is exact for a power of two" {
    receiver {
        narrow_numerator = 1.0;
        narrow_denominator = 4.0;
    }

    expect return 0.25;
}
