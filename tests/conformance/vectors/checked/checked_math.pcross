// Conformance vectors for abs under the checked overflow policy (spec 10.5).
//
// An integer's abs follows the project's overflow policy, as unary '-' does: the minimum has no magnitude of its
// type, and under this policy taking it ends the program, with the exit code 'on_zero fail' has. Every other value
// is unaffected by the policy.

import proto "checked_math.proto";

extend CheckedMathCase {
    fn abs_i32() -> int32 {
        return _pCrossMath.abs(i32);
    }

    fn abs_i64() -> int64 {
        return _pCrossMath.abs(i64);
    }
}

test CheckedMathCase.abs_i32 "abs of a negative int32 that fits returns its magnitude" {
    receiver {
        i32: -2147483647,
    }

    expect return 2147483647;
}

test CheckedMathCase.abs_i32 "abs of the int32 minimum terminates" {
    receiver {
        i32: -2147483648,
    }

    expect fail;
}

test CheckedMathCase.abs_i64 "abs of a negative int64 that fits returns its magnitude" {
    receiver {
        i64: -9223372036854775807,
    }

    expect return 9223372036854775807;
}

test CheckedMathCase.abs_i64 "abs of the int64 minimum terminates" {
    receiver {
        i64: -9223372036854775808,
    }

    expect fail;
}
