            new CheckedIntegerSweepUint32Row { left: 2, right: 2147483647, expected: 2147483649 }, // 16
            new CheckedIntegerSweepUint32Row { left: 2, right: 2147483648, expected: 2147483650 }, // 17
            new CheckedIntegerSweepUint32Row { left: 2147483647, right: 0, expected: 2147483647 }, // 18
            new CheckedIntegerSweepUint32Row { left: 2147483647, right: 1, expected: 2147483648 }, // 19
            new CheckedIntegerSweepUint32Row { left: 2147483647, right: 2, expected: 2147483649 }, // 20
            new CheckedIntegerSweepUint32Row { left: 2147483647, right: 2147483647, expected: 4294967294 }, // 21
            new CheckedIntegerSweepUint32Row { left: 2147483647, right: 2147483648, expected: 4294967295 }, // 22
