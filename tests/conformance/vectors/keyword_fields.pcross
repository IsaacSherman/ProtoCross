// Conformance vectors for protobuf fields whose names are C++ keywords (spec 24.2).
//
// None of these names means anything special to ProtoCross, so an author writes them like any
// other field. The trouble is entirely in the target: protoc will not generate a C++ member called
// 'class()' or 'new()', and neither does it keep the bare name for the prefixed accessors -- the
// setter is 'set_class_()', not 'set_class()'. A backend that spells the accessor after the
// .proto file instead of after the generated header emits C++ that does not compile, and it does
// so for a schema that is perfectly ordinary everywhere else.
//
// So each method reads one field by one accessor shape, and the fixtures write every one of them:
// the getter, 'has', and the setter, 'mutable_' and 'add_' forms that build a receiver.

import proto "keyword_fields.proto";

extend KeywordFieldCase {
    fn class_value() -> int64 {
        return class;
    }

    // A message-typed field, its presence, and a keyword-named field one level inside it.
    fn new_this() -> int64 {
        if has new {
            return new.this;
        }

        return -1;
    }

    fn delete_total() -> int64 {
        var total: int64 = 0;

        for value in delete {
            total = total + value;
        }

        return total;
    }

    fn template_total() -> int64 {
        var total: int64 = 0;

        for entry in template {
            total = total + entry.this;
        }

        return total;
    }

    // Explicit presence on a scalar, so 'has' reaches the escaped has_default_() as well.
    fn default_is_set() -> bool {
        return has default;
    }

    fn friend_value() -> int64 {
        return Friend;
    }

    fn default_instance_value() -> int64 {
        return default_instance;
    }

    fn assert_value() -> int64 {
        return assert;
    }
}

test KeywordFieldCase.class_value "reads a scalar field named class" {
    receiver {
        class = 3;
    }

    expect return 3;
}

test KeywordFieldCase.new_this "reads through a message field named new to a field named this" {
    receiver {
        new { this = 5; }
    }

    expect return 5;
}

test KeywordFieldCase.new_this "an unset message field named new takes the guard's other branch" {
    receiver {
        class = 1;
    }

    expect return -1;
}

test KeywordFieldCase.delete_total "iterates a repeated scalar field named delete" {
    receiver {
        delete = 2;
        delete = 3;
        delete = 4;
    }

    expect return 9;
}

test KeywordFieldCase.template_total "iterates a repeated message field named template" {
    receiver {
        template { this = 10; }
        template { this = 20; }
    }

    expect return 30;
}

test KeywordFieldCase.default_is_set "has default is true for an explicit zero" {
    receiver {
        default = 0;
    }

    expect return true;
}

test KeywordFieldCase.default_is_set "has default is false when it was never set" {
    receiver {
        class = 1;
    }

    expect return false;
}

test KeywordFieldCase.friend_value "a capitalized keyword is lowercased before it is escaped" {
    receiver {
        Friend = 7;
    }

    expect return 7;
}

test KeywordFieldCase.default_instance_value "a field named after a generated member is escaped too" {
    receiver {
        default_instance = 11;
    }

    expect return 11;
}

test KeywordFieldCase.assert_value "a field named assert is escaped though it is a macro" {
    receiver {
        assert = 13;
    }

    expect return 13;
}
