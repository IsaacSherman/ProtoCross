// Conformance vectors for % on floating-point operands.
//
// The remainder is the one a truncating division leaves: x - trunc(x / y) * y, computed exactly,
// so it carries the sign of the dividend. Like floating-point division it cannot fail, so no
// on_zero clause is allowed; a zero divisor or an infinite dividend yields NaN, and an infinite
// divisor leaves the dividend unchanged.
//
// There is no literal for an infinity, so the methods that need one build it as a division by zero,
// which floating_point.pcross pins separately. NaN and negative zero are checked through the
// properties that identify them, as floating_point.pcross does: a NaN is unequal to itself, and a
// zero is negative when dividing by it yields a negative infinity.

import proto "conformance.proto";

extend RemainderCase {
    fn remainder() -> double {
        return dividend % divisor;
    }

    fn narrow_remainder() -> float {
        return narrow_dividend % narrow_divisor;
    }

    fn is_nan() -> bool {
        var r: double = dividend % divisor;
        return r != r;
    }

    fn is_negative_zero() -> bool {
        var r: double = dividend % divisor;
        return r == 0.0 and 1.0 / r < 0.0;
    }

    fn infinite_dividend_is_nan() -> bool {
        var infinity: double = 1.0 / 0.0;
        var r: double = infinity % divisor;
        return r != r;
    }

    fn infinite_divisor_leaves_dividend() -> bool {
        var infinity: double = 1.0 / 0.0;
        return dividend % infinity == dividend;
    }
}

test RemainderCase.remainder "the remainder of positive operands" {
    receiver {
        dividend = 7.5;
        divisor = 2.0;
    }

    expect return 1.5;
}

test RemainderCase.remainder "the remainder takes the sign of a negative dividend" {
    receiver {
        dividend = -7.5;
        divisor = 2.0;
    }

    expect return -1.5;
}

test RemainderCase.remainder "the sign of the divisor does not reach the remainder" {
    receiver {
        dividend = 7.5;
        divisor = -2.0;
    }

    expect return 1.5;
}

// 10^20 is exactly representable and leaves 1 when divided by 3. Computing x - trunc(x / y) * y
// in floating point rounds the quotient and gets this wrong, so it pins an exact remainder.
test RemainderCase.remainder "the remainder is exact for a dividend far larger than the divisor" {
    receiver {
        dividend = 100000000000000000000.0;
        divisor = 3.0;
    }

    expect return 1.0;
}

test RemainderCase.is_negative_zero "an exact negative multiple leaves a negative zero" {
    receiver {
        dividend = -4.0;
        divisor = 2.0;
    }

    expect return true;
}

test RemainderCase.is_nan "the remainder by zero is NaN" {
    receiver {
        dividend = 7.5;
        divisor = 0.0;
    }

    expect return true;
}

test RemainderCase.is_nan "an ordinary remainder is not NaN" {
    receiver {
        dividend = 7.5;
        divisor = 2.0;
    }

    expect return false;
}

test RemainderCase.infinite_dividend_is_nan "the remainder of an infinity is NaN" {
    receiver {
        divisor = 2.0;
    }

    expect return true;
}

test RemainderCase.infinite_divisor_leaves_dividend "the remainder by an infinity is the dividend" {
    receiver {
        dividend = -7.5;
    }

    expect return true;
}

test RemainderCase.narrow_remainder "float remainder follows the same rules as double" {
    receiver {
        narrow_dividend = -7.5;
        narrow_divisor = 2.0;
    }

    expect return -1.5;
}
