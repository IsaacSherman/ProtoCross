test FloatingSweepDouble.first_wrong_sum "every double sum of two values" {
    receiver {
        sums { left = 0.0; right = 0.0; expected = 0.0; } // 0
        sums { left = 0.0; right = -0.0; expected = 0.0; } // 1
        sums { left = 0.0; right = 0.1; expected = 0.1; } // 2
        sums { left = 0.0; right = 1.0; expected = 1.0; } // 3
        sums { left = 0.0; right = -1.5; expected = -1.5; } // 4
        sums { left = 0.0; right = 1.7976931348623157E+308; expected = 1.7976931348623157E+308; } // 5
        sums { left = 0.0; right = 5E-324; expected = 5E-324; } // 6
        sums { left = 0.0; right = __INF; expected = __INF; } // 7
        sums { left = 0.0; right = -__INF; expected = -__INF; } // 8
        sums { left = 0.0; right = __NAN; nan = true; } // 9
        sums { left = -0.0; right = 0.0; expected = 0.0; } // 10
        sums { left = -0.0; right = -0.0; expected = -0.0; } // 11
        sums { left = -0.0; right = 0.1; expected = 0.1; } // 12
        sums { left = -0.0; right = 1.0; expected = 1.0; } // 13
        sums { left = -0.0; right = -1.5; expected = -1.5; } // 14
