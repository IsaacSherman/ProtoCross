            new FloatingSweepDoubleRow { left: __NAN, right: __INF, nan: true }, // 97
            new FloatingSweepDoubleRow { left: __NAN, right: -__INF, nan: true }, // 98
            new FloatingSweepDoubleRow { left: __NAN, right: __NAN, nan: true }, // 99
        ],
    }

    expect return -1;
}

test FloatingSweepDouble.first_wrong_negation "the double negation of every value" {
    receiver {
        negations: [
            new FloatingSweepDoubleNegation { operand: 0.0, expected: -0.0 }, // 0
            new FloatingSweepDoubleNegation { operand: -0.0, expected: 0.0 }, // 1
            new FloatingSweepDoubleNegation { operand: 0.1, expected: -0.1 }, // 2
            new FloatingSweepDoubleNegation { operand: 1.0, expected: -1.0 }, // 3
            new FloatingSweepDoubleNegation { operand: -1.5, expected: 1.5 }, // 4
            new FloatingSweepDoubleNegation { operand: 1.7976931348623157E+308, expected: -1.7976931348623157E+308 }, // 5
            new FloatingSweepDoubleNegation { operand: 5E-324, expected: -5E-324 }, // 6
            new FloatingSweepDoubleNegation { operand: __INF, expected: -__INF }, // 7
            new FloatingSweepDoubleNegation { operand: -__INF, expected: __INF }, // 8
            new FloatingSweepDoubleNegation { operand: __NAN, nan: true }, // 9
        ],
    }

    expect return -1;
}

