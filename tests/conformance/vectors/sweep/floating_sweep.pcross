        sums { left = -0.0; right = -__INF; expected = -__INF; } // 18
        sums { left = -0.0; right = __NAN; nan = true; } // 19
        sums { left = 0.1; right = 0.0; expected = 0.1; } // 20
        sums { left = 0.1; right = -0.0; expected = 0.1; } // 21
        sums { left = 0.1; right = 0.1; expected = 0.2; } // 22
        sums { left = 0.1; right = 1.0; expected = 1.1; } // 23
        sums { left = 0.1; right = -1.5; expected = -1.4; } // 24
        sums { left = 0.1; right = 1.7976931348623157E+308; expected = 1.7976931348623157E+308; } // 25
        sums { left = 0.1; right = 5E-324; expected = 0.1; } // 26
        sums { left = 0.1; right = __INF; expected = __INF; } // 27
        sums { left = 0.1; right = -__INF; expected = -__INF; } // 28
        sums { left = 0.1; right = __NAN; nan = true; } // 29
        sums { left = 1.0; right = 0.0; expected = 1.0; } // 30
