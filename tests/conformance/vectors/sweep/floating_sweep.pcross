test FloatingSweepDouble.first_wrong_negation "the double negation of every value" {
    receiver {
        negations { operand = 0.0; expected = -0.0; } // 0
        negations { operand = -0.0; expected = 0.0; } // 1
        negations { operand = 0.1; expected = -0.1; } // 2
        negations { operand = 1.0; expected = -1.0; } // 3
        negations { operand = -1.5; expected = 1.5; } // 4
        negations { operand = 1.7976931348623157E+308; expected = -1.7976931348623157E+308; } // 5
        negations { operand = 5E-324; expected = -5E-324; } // 6
        negations { operand = __INF; expected = -__INF; } // 7
        negations { operand = -__INF; expected = __INF; } // 8
        negations { operand = __NAN; nan = true; } // 9
    }

    expect return -1;
}

