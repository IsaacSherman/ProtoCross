        sums { left = 1.0; right = 0.1; expected = 1.1; } // 32
        sums { left = 1.0; right = 1.0; expected = 2.0; } // 33
        sums { left = 1.0; right = -1.5; expected = -0.5; } // 34
        sums { left = 1.0; right = 1.7976931348623157E+308; expected = 1.7976931348623157E+308; } // 35
        sums { left = 1.0; right = 5E-324; expected = 1.0; } // 36
        sums { left = 1.0; right = __INF; expected = __INF; } // 37
        sums { left = 1.0; right = -__INF; expected = -__INF; } // 38
        sums { left = 1.0; right = __NAN; nan = true; } // 39
        sums { left = -1.5; right = 0.0; expected = -1.5; } // 40
