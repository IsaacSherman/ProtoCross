// Generated by tests/ProtoCross.Tests/Conformance/Sweep. Do not edit it by hand: change the
// generator, then run ArithmeticSweepTests with PROTOCROSS_REGENERATE_SWEEP=1 to rewrite it.
//
// Every floating-point arithmetic operator, negation, and every comparison (spec 10.2), over every
// pair of values IEEE 754 has something particular to say about: both zeros, a value no binary
// fraction holds, one and a negative fraction, the largest finite value, the smallest subnormal,
// both infinities, and NaN. In float and in double.
//
// The expected values are C#'s own arithmetic, which spec 10 names as the reference, done in each
// type's own precision. A row expecting NaN says so rather than naming a value, since a NaN equals
// nothing. Every other row compares 1 / x as well, which is what tells 0.0 from -0.0.
//
// Each test walks one table and returns the index of the first row the backend got wrong, or -1.
// Every row carries its index in a comment. The overflow policy governs none of this (spec 10.4),
// so it is swept once.

import proto "floating_sweep.proto";

extend FloatingSweepFloat {
    fn same(actual: float, expected: float, nan: bool) -> bool {
        if nan {
            return actual != actual;
        }

        return actual == expected and 1.0 / actual == 1.0 / expected;
    }

    fn first_wrong_sum() -> int32 {
        var index: int32 = 0;

        for row in sums {
            if not same(row.left + row.right, row.expected, row.nan) {
                return index;
            }

            index = index + 1;
        }

        return -1;
    }

    fn first_wrong_difference() -> int32 {
        var index: int32 = 0;

        for row in differences {
            if not same(row.left - row.right, row.expected, row.nan) {
                return index;
            }

            index = index + 1;
        }

        return -1;
    }

    fn first_wrong_product() -> int32 {
        var index: int32 = 0;

        for row in products {
            if not same(row.left * row.right, row.expected, row.nan) {
                return index;
            }

            index = index + 1;
        }

        return -1;
    }

    fn first_wrong_quotient() -> int32 {
        var index: int32 = 0;

        for row in quotients {
            if not same(row.left / row.right, row.expected, row.nan) {
                return index;
            }

            index = index + 1;
        }

        return -1;
    }

    fn first_wrong_remainder() -> int32 {
        var index: int32 = 0;

        for row in remainders {
            if not same(row.left % row.right, row.expected, row.nan) {
                return index;
            }

            index = index + 1;
        }

        return -1;
    }

    fn first_wrong_negation() -> int32 {
        var index: int32 = 0;

        for row in negations {
            if not same(-row.operand, row.expected, row.nan) {
                return index;
            }

            index = index + 1;
        }

        return -1;
    }

    fn first_wrong_comparison() -> int32 {
        var index: int32 = 0;

        for row in comparisons {
            if (row.left < row.right) != row.lt
                or (row.left <= row.right) != row.le
                or (row.left > row.right) != row.gt
                or (row.left >= row.right) != row.ge
                or (row.left == row.right) != row.eq
                or (row.left != row.right) != row.ne {
                return index;
            }

            index = index + 1;
        }

        return -1;
    }
}

