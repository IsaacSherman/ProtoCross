test FloatingSweepFloat.first_wrong_negation "the float negation of every value" {
    receiver {
        negations: [
            new FloatingSweepFloatNegation { operand: 0.0, expected: -0.0 }, // 0
            new FloatingSweepFloatNegation { operand: -0.0, expected: 0.0 }, // 1
            new FloatingSweepFloatNegation { operand: 0.1, expected: -0.1 }, // 2
            new FloatingSweepFloatNegation { operand: 1.0, expected: -1.0 }, // 3
            new FloatingSweepFloatNegation { operand: -1.5, expected: 1.5 }, // 4
            new FloatingSweepFloatNegation { operand: 3.4028235E+38, expected: -3.4028235E+38 }, // 5
            new FloatingSweepFloatNegation { operand: 1E-45, expected: -1E-45 }, // 6
            new FloatingSweepFloatNegation { operand: __INF, expected: -__INF }, // 7
            new FloatingSweepFloatNegation { operand: -__INF, expected: __INF }, // 8
            new FloatingSweepFloatNegation { operand: __NAN, nan: true }, // 9
        ],
    }

    expect return -1;
}

