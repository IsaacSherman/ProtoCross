test BitwiseSweepUint32.first_wrong_complement "the uint32 complement of every boundary value" {
    receiver {
        complements: [
            new BitwiseSweepUint32Complement { operand: 0, expected: 4294967295 }, // 0
            new BitwiseSweepUint32Complement { operand: 1, expected: 4294967294 }, // 1
            new BitwiseSweepUint32Complement { operand: 2, expected: 4294967293 }, // 2
            new BitwiseSweepUint32Complement { operand: 2147483647, expected: 2147483648 }, // 3
            new BitwiseSweepUint32Complement { operand: 2147483648, expected: 2147483647 }, // 4
            new BitwiseSweepUint32Complement { operand: 4294967294, expected: 1 }, // 5
            new BitwiseSweepUint32Complement { operand: 4294967295, expected: 0 }, // 6
        ],
    }

    expect return -1;
}

test BitwiseSweepUint32.first_wrong_left_shift_by_int32 "the uint32 1 shifted left by every int32 count worth trying" {
    receiver {
        left_shifts_by_int32: [
            new BitwiseSweepUint32ShiftByInt32 { value: 1, count: 0, expected: 1 }, // 0
            new BitwiseSweepUint32ShiftByInt32 { value: 1, count: 1, expected: 2 }, // 1
            new BitwiseSweepUint32ShiftByInt32 { value: 1, count: 16, expected: 65536 }, // 2
            new BitwiseSweepUint32ShiftByInt32 { value: 1, count: 31, expected: 2147483648 }, // 3
            new BitwiseSweepUint32ShiftByInt32 { value: 1, count: 32, expected: 1 }, // 4
            new BitwiseSweepUint32ShiftByInt32 { value: 1, count: 33, expected: 2 }, // 5
            new BitwiseSweepUint32ShiftByInt32 { value: 1, count: 64, expected: 1 }, // 6
            new BitwiseSweepUint32ShiftByInt32 { value: 1, count: 2147483647, expected: 2147483648 }, // 7
            new BitwiseSweepUint32ShiftByInt32 { value: 1, count: -1, expected: 2147483648 }, // 8
            new BitwiseSweepUint32ShiftByInt32 { value: 1, count: -2147483648, expected: 1 }, // 9
        ],
    }

    expect return -1;
}

