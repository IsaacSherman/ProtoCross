test BitwiseSweepInt32.first_wrong_and "every int32 bitwise and of two boundary values" {
    receiver {
        ands: [
            new BitwiseSweepInt32Row { left: -2147483648, right: -2147483648, expected: -2147483648 }, // 0
            new BitwiseSweepInt32Row { left: -2147483648, right: -2147483647, expected: -2147483648 }, // 1
            new BitwiseSweepInt32Row { left: -2147483648, right: -1, expected: -2147483648 }, // 2
            new BitwiseSweepInt32Row { left: -2147483648, right: 0, expected: 0 }, // 3
            new BitwiseSweepInt32Row { left: -2147483648, right: 1, expected: 0 }, // 4
            new BitwiseSweepInt32Row { left: -2147483648, right: 2147483646, expected: 0 }, // 5
            new BitwiseSweepInt32Row { left: -2147483648, right: 2147483647, expected: 0 }, // 6
            new BitwiseSweepInt32Row { left: -2147483647, right: -2147483648, expected: -2147483648 }, // 7
            new BitwiseSweepInt32Row { left: -2147483647, right: -2147483647, expected: -2147483647 }, // 8
            new BitwiseSweepInt32Row { left: -2147483647, right: -1, expected: -2147483647 }, // 9
            new BitwiseSweepInt32Row { left: -2147483647, right: 0, expected: 0 }, // 10
            new BitwiseSweepInt32Row { left: -2147483647, right: 1, expected: 1 }, // 11
            new BitwiseSweepInt32Row { left: -2147483647, right: 2147483646, expected: 0 }, // 12
            new BitwiseSweepInt32Row { left: -2147483647, right: 2147483647, expected: 1 }, // 13
            new BitwiseSweepInt32Row { left: -1, right: -2147483648, expected: -2147483648 }, // 14
            new BitwiseSweepInt32Row { left: -1, right: -2147483647, expected: -2147483647 }, // 15
            new BitwiseSweepInt32Row { left: -1, right: -1, expected: -1 }, // 16
            new BitwiseSweepInt32Row { left: -1, right: 0, expected: 0 }, // 17
            new BitwiseSweepInt32Row { left: -1, right: 1, expected: 1 }, // 18
            new BitwiseSweepInt32Row { left: -1, right: 2147483646, expected: 2147483646 }, // 19
            new BitwiseSweepInt32Row { left: -1, right: 2147483647, expected: 2147483647 }, // 20
            new BitwiseSweepInt32Row { left: 0, right: -2147483648, expected: 0 }, // 21
            new BitwiseSweepInt32Row { left: 0, right: -2147483647, expected: 0 }, // 22
            new BitwiseSweepInt32Row { left: 0, right: -1, expected: 0 }, // 23
            new BitwiseSweepInt32Row { left: 0, right: 0, expected: 0 }, // 24
            new BitwiseSweepInt32Row { left: 0, right: 1, expected: 0 }, // 25
            new BitwiseSweepInt32Row { left: 0, right: 2147483646, expected: 0 }, // 26
            new BitwiseSweepInt32Row { left: 0, right: 2147483647, expected: 0 }, // 27
            new BitwiseSweepInt32Row { left: 1, right: -2147483648, expected: 0 }, // 28
            new BitwiseSweepInt32Row { left: 1, right: -2147483647, expected: 1 }, // 29
            new BitwiseSweepInt32Row { left: 1, right: -1, expected: 1 }, // 30
            new BitwiseSweepInt32Row { left: 1, right: 0, expected: 0 }, // 31
            new BitwiseSweepInt32Row { left: 1, right: 1, expected: 1 }, // 32
            new BitwiseSweepInt32Row { left: 1, right: 2147483646, expected: 0 }, // 33
            new BitwiseSweepInt32Row { left: 1, right: 2147483647, expected: 1 }, // 34
            new BitwiseSweepInt32Row { left: 2147483646, right: -2147483648, expected: 0 }, // 35
            new BitwiseSweepInt32Row { left: 2147483646, right: -2147483647, expected: 0 }, // 36
            new BitwiseSweepInt32Row { left: 2147483646, right: -1, expected: 2147483646 }, // 37
            new BitwiseSweepInt32Row { left: 2147483646, right: 0, expected: 0 }, // 38
            new BitwiseSweepInt32Row { left: 2147483646, right: 1, expected: 0 }, // 39
            new BitwiseSweepInt32Row { left: 2147483646, right: 2147483646, expected: 2147483646 }, // 40
            new BitwiseSweepInt32Row { left: 2147483646, right: 2147483647, expected: 2147483646 }, // 41
            new BitwiseSweepInt32Row { left: 2147483647, right: -2147483648, expected: 0 }, // 42
            new BitwiseSweepInt32Row { left: 2147483647, right: -2147483647, expected: 1 }, // 43
            new BitwiseSweepInt32Row { left: 2147483647, right: -1, expected: 2147483647 }, // 44
            new BitwiseSweepInt32Row { left: 2147483647, right: 0, expected: 0 }, // 45
            new BitwiseSweepInt32Row { left: 2147483647, right: 1, expected: 1 }, // 46
            new BitwiseSweepInt32Row { left: 2147483647, right: 2147483646, expected: 2147483646 }, // 47
            new BitwiseSweepInt32Row { left: 2147483647, right: 2147483647, expected: 2147483647 }, // 48
        ],
    }

    expect return -1;
}

