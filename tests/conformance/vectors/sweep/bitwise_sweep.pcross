            new BitwiseSweepUint32ShiftByUint32 { value: 4294967295, count: 4294967295, expected: 2147483648 }, // 55
        ],
    }

    expect return -1;
}

test BitwiseSweepUint32.first_wrong_left_shift_by_uint64 "the uint32 1 shifted left by every uint64 count worth trying" {
