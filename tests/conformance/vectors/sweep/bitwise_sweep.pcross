test BitwiseSweepInt32.first_wrong_complement "the int32 complement of every boundary value" {
    receiver {
        complements: [
            new BitwiseSweepInt32Complement { operand: -2147483648, expected: 2147483647 }, // 0
            new BitwiseSweepInt32Complement { operand: -2147483647, expected: 2147483646 }, // 1
            new BitwiseSweepInt32Complement { operand: -1, expected: 0 }, // 2
            new BitwiseSweepInt32Complement { operand: 0, expected: -1 }, // 3
            new BitwiseSweepInt32Complement { operand: 1, expected: -2 }, // 4
            new BitwiseSweepInt32Complement { operand: 2147483646, expected: -2147483647 }, // 5
            new BitwiseSweepInt32Complement { operand: 2147483647, expected: -2147483648 }, // 6
        ],
    }

    expect return -1;
}

