test BitwiseSweepInt32.first_wrong_xor "every int32 bitwise xor of two boundary values" {
    receiver {
        xors { left = -2147483648; right = -2147483648; expected = 0; } // 0
        xors { left = -2147483648; right = -2147483647; expected = 1; } // 1
        xors { left = -2147483648; right = -1; expected = 2147483647; } // 2
        xors { left = -2147483648; right = 0; expected = -2147483648; } // 3
        xors { left = -2147483648; right = 1; expected = -2147483647; } // 4
        xors { left = -2147483648; right = 2147483646; expected = -2; } // 5
        xors { left = -2147483648; right = 2147483647; expected = -1; } // 6
        xors { left = -2147483647; right = -2147483648; expected = 1; } // 7
