test BitwiseSweepInt32.first_wrong_left_shift_by_int64 "the int32 1 shifted left by every int64 count worth trying" {
    receiver {
        left_shifts_by_int64: [
            new BitwiseSweepInt32ShiftByInt64 { value: 1, count: 0, expected: 1 }, // 0
            new BitwiseSweepInt32ShiftByInt64 { value: 1, count: 1, expected: 2 }, // 1
            new BitwiseSweepInt32ShiftByInt64 { value: 1, count: 16, expected: 65536 }, // 2
            new BitwiseSweepInt32ShiftByInt64 { value: 1, count: 31, expected: -2147483648 }, // 3
            new BitwiseSweepInt32ShiftByInt64 { value: 1, count: 32, expected: 1 }, // 4
            new BitwiseSweepInt32ShiftByInt64 { value: 1, count: 33, expected: 2 }, // 5
            new BitwiseSweepInt32ShiftByInt64 { value: 1, count: 64, expected: 1 }, // 6
            new BitwiseSweepInt32ShiftByInt64 { value: 1, count: 9223372036854775807, expected: -2147483648 }, // 7
            new BitwiseSweepInt32ShiftByInt64 { value: 1, count: -1, expected: -2147483648 }, // 8
            new BitwiseSweepInt32ShiftByInt64 { value: 1, count: -9223372036854775808, expected: 1 }, // 9
        ],
    }

    expect return -1;
}

