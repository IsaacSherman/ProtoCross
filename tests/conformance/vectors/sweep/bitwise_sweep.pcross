test BitwiseSweepInt64.first_wrong_complement "the int64 complement of every boundary value" {
    receiver {
        complements { operand = -9223372036854775808; expected = 9223372036854775807; } // 0
        complements { operand = -9223372036854775807; expected = 9223372036854775806; } // 1
        complements { operand = -1; expected = 0; } // 2
        complements { operand = 0; expected = -1; } // 3
        complements { operand = 1; expected = -2; } // 4
        complements { operand = 9223372036854775806; expected = -9223372036854775807; } // 5
        complements { operand = 9223372036854775807; expected = -9223372036854775808; } // 6
    }

    expect return -1;
}

test BitwiseSweepInt64.first_wrong_left_shift_by_int32 "the int64 1 shifted left by every int32 count worth trying" {
    receiver {
        left_shifts_by_int32 { value = 1; count = 0; expected = 1; } // 0
        left_shifts_by_int32 { value = 1; count = 1; expected = 2; } // 1
        left_shifts_by_int32 { value = 1; count = 32; expected = 4294967296; } // 2
        left_shifts_by_int32 { value = 1; count = 63; expected = -9223372036854775808; } // 3
        left_shifts_by_int32 { value = 1; count = 64; expected = 1; } // 4
        left_shifts_by_int32 { value = 1; count = 65; expected = 2; } // 5
        left_shifts_by_int32 { value = 1; count = 128; expected = 1; } // 6
        left_shifts_by_int32 { value = 1; count = 2147483647; expected = -9223372036854775808; } // 7
        left_shifts_by_int32 { value = 1; count = -1; expected = -9223372036854775808; } // 8
        left_shifts_by_int32 { value = 1; count = -2147483648; expected = 1; } // 9
    }

    expect return -1;
}

