        left_shifts_by_int64 { value = 1; count = 9223372036854775807; expected = -2147483648; } // 7
        left_shifts_by_int64 { value = 1; count = -1; expected = -2147483648; } // 8
        left_shifts_by_int64 { value = 1; count = -9223372036854775808; expected = 1; } // 9
    }

    expect return -1;
}

