        xors { left = -2147483647; right = -1; expected = 2147483646; } // 9
        xors { left = -2147483647; right = 0; expected = -2147483647; } // 10
        xors { left = -2147483647; right = 1; expected = -2147483648; } // 11
        xors { left = -2147483647; right = 2147483646; expected = -1; } // 12
