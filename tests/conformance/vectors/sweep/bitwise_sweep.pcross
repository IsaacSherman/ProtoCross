            new BitwiseSweepInt64ShiftByUint64 { value: -9223372036854775808, count: 128, expected: -9223372036854775808 }, // 6
            new BitwiseSweepInt64ShiftByUint64 { value: -9223372036854775808, count: 18446744073709551615, expected: -1 }, // 7
        ],
    }

    expect return -1;
}

