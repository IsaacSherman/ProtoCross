            new BitwiseSweepInt32ShiftByInt32 { value: 2147483647, count: 1, expected: 1073741823 }, // 61
            new BitwiseSweepInt32ShiftByInt32 { value: 2147483647, count: 16, expected: 32767 }, // 62
            new BitwiseSweepInt32ShiftByInt32 { value: 2147483647, count: 31, expected: 0 }, // 63
            new BitwiseSweepInt32ShiftByInt32 { value: 2147483647, count: 32, expected: 2147483647 }, // 64
            new BitwiseSweepInt32ShiftByInt32 { value: 2147483647, count: 33, expected: 1073741823 }, // 65
            new BitwiseSweepInt32ShiftByInt32 { value: 2147483647, count: 64, expected: 2147483647 }, // 66
            new BitwiseSweepInt32ShiftByInt32 { value: 2147483647, count: 2147483647, expected: 0 }, // 67
            new BitwiseSweepInt32ShiftByInt32 { value: 2147483647, count: -1, expected: 0 }, // 68
            new BitwiseSweepInt32ShiftByInt32 { value: 2147483647, count: -2147483648, expected: 2147483647 }, // 69
        ],
    }

    expect return -1;
}

