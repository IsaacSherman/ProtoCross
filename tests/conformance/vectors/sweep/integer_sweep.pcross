            new IntegerSweepUint32Row { left: 1, right: 4294967295, expected: 0 }, // 13
            new IntegerSweepUint32Row { left: 2, right: 0, expected: 2 }, // 14
            new IntegerSweepUint32Row { left: 2, right: 1, expected: 3 }, // 15
            new IntegerSweepUint32Row { left: 2, right: 2, expected: 4 }, // 16
