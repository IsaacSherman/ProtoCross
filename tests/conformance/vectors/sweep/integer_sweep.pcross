            new IntegerSweepUint32Row { left: 2, right: 4294967295, expected: 1 }, // 20
            new IntegerSweepUint32Row { left: 2147483647, right: 0, expected: 2147483647 }, // 21
            new IntegerSweepUint32Row { left: 2147483647, right: 1, expected: 2147483648 }, // 22
            new IntegerSweepUint32Row { left: 2147483647, right: 2, expected: 2147483649 }, // 23
            new IntegerSweepUint32Row { left: 2147483647, right: 2147483647, expected: 4294967294 }, // 24
            new IntegerSweepUint32Row { left: 2147483647, right: 2147483648, expected: 4294967295 }, // 25
            new IntegerSweepUint32Row { left: 2147483647, right: 4294967294, expected: 2147483645 }, // 26
            new IntegerSweepUint32Row { left: 2147483647, right: 4294967295, expected: 2147483646 }, // 27
            new IntegerSweepUint32Row { left: 2147483648, right: 0, expected: 2147483648 }, // 28
            new IntegerSweepUint32Row { left: 2147483648, right: 1, expected: 2147483649 }, // 29
            new IntegerSweepUint32Row { left: 2147483648, right: 2, expected: 2147483650 }, // 30
            new IntegerSweepUint32Row { left: 2147483648, right: 2147483647, expected: 4294967295 }, // 31
            new IntegerSweepUint32Row { left: 2147483648, right: 2147483648, expected: 0 }, // 32
            new IntegerSweepUint32Row { left: 2147483648, right: 4294967294, expected: 2147483646 }, // 33
            new IntegerSweepUint32Row { left: 2147483648, right: 4294967295, expected: 2147483647 }, // 34
            new IntegerSweepUint32Row { left: 4294967294, right: 0, expected: 4294967294 }, // 35
            new IntegerSweepUint32Row { left: 4294967294, right: 1, expected: 4294967295 }, // 36
            new IntegerSweepUint32Row { left: 4294967294, right: 2, expected: 0 }, // 37
            new IntegerSweepUint32Row { left: 4294967294, right: 2147483647, expected: 2147483645 }, // 38
            new IntegerSweepUint32Row { left: 4294967294, right: 2147483648, expected: 2147483646 }, // 39
