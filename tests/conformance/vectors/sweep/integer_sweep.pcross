test IntegerSweepUint32.first_wrong_quotient "every uint32 quotient of two boundary values, wrapped, and the fallback for a zero divisor" {
    receiver {
        quotients: [
            new IntegerSweepUint32Row { left: 0, right: 0, expected: 7 }, // 0
            new IntegerSweepUint32Row { left: 0, right: 1, expected: 0 }, // 1
            new IntegerSweepUint32Row { left: 0, right: 2, expected: 0 }, // 2
