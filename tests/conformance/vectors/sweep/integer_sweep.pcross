test IntegerSweepUint32.first_wrong_sum "every uint32 sum of two boundary values, wrapped" {
    receiver {
        sums: [
            new IntegerSweepUint32Row { left: 0, right: 0, expected: 0 }, // 0
            new IntegerSweepUint32Row { left: 0, right: 1, expected: 1 }, // 1
            new IntegerSweepUint32Row { left: 0, right: 2, expected: 2 }, // 2
            new IntegerSweepUint32Row { left: 0, right: 2147483647, expected: 2147483647 }, // 3
            new IntegerSweepUint32Row { left: 0, right: 2147483648, expected: 2147483648 }, // 4
            new IntegerSweepUint32Row { left: 0, right: 4294967294, expected: 4294967294 }, // 5
            new IntegerSweepUint32Row { left: 0, right: 4294967295, expected: 4294967295 }, // 6
            new IntegerSweepUint32Row { left: 1, right: 0, expected: 1 }, // 7
            new IntegerSweepUint32Row { left: 1, right: 1, expected: 2 }, // 8
            new IntegerSweepUint32Row { left: 1, right: 2, expected: 3 }, // 9
            new IntegerSweepUint32Row { left: 1, right: 2147483647, expected: 2147483648 }, // 10
            new IntegerSweepUint32Row { left: 1, right: 2147483648, expected: 2147483649 }, // 11
