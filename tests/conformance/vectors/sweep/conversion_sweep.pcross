test ConversionSweep.first_wrong_int32_as_int32 "every int32 value as int32" {
    receiver {
        int32_as_int32: [
            new ConversionSweepInt32AsInt32 { value: -2147483648, expected: -2147483648 }, // 0
            new ConversionSweepInt32AsInt32 { value: -2147483647, expected: -2147483647 }, // 1
            new ConversionSweepInt32AsInt32 { value: -16777217, expected: -16777217 }, // 2
            new ConversionSweepInt32AsInt32 { value: -1, expected: -1 }, // 3
            new ConversionSweepInt32AsInt32 { value: 0, expected: 0 }, // 4
            new ConversionSweepInt32AsInt32 { value: 1, expected: 1 }, // 5
            new ConversionSweepInt32AsInt32 { value: 16777217, expected: 16777217 }, // 6
            new ConversionSweepInt32AsInt32 { value: 16777219, expected: 16777219 }, // 7
            new ConversionSweepInt32AsInt32 { value: 2147483646, expected: 2147483646 }, // 8
            new ConversionSweepInt32AsInt32 { value: 2147483647, expected: 2147483647 }, // 9
        ],
    }

    expect return -1;
}

