// Generated by tests/ProtoCross.Tests/Conformance/Sweep. Do not edit it by hand: change the
// generator, then run ArithmeticSweepTests with PROTOCROSS_REGENERATE_SWEEP=1 to rewrite it.
//
// Every integer arithmetic operator (spec 10.1, 10.2) over every pair of boundary values of each
// integer type, under the Saturating policy, which the protocross.config.xml above this directory
// selects.
//
// The expected values were computed exactly, in arbitrary precision, and only then brought into
// range the way the policy says. Nothing either backend emits had a hand in them.
//
// Each test walks one table and returns the index of the first row the backend got wrong, or -1.
// Every row carries its index in a comment. A zero divisor takes the fallback, 7.

import proto "saturating_integer_sweep.proto";

extend SaturatingIntegerSweepInt32 {
    fn first_wrong_sum() -> int32 {
        var index: int32 = 0;

        for row in sums {
            if row.left + row.right != row.expected {
                return index;
            }

            index = index + 1;
        }

        return -1;
    }

    fn first_wrong_difference() -> int32 {
        var index: int32 = 0;

        for row in differences {
            if row.left - row.right != row.expected {
                return index;
            }

            index = index + 1;
        }

        return -1;
    }

    fn first_wrong_product() -> int32 {
        var index: int32 = 0;

        for row in products {
            if row.left * row.right != row.expected {
                return index;
            }

            index = index + 1;
        }

        return -1;
    }

    fn first_wrong_quotient() -> int32 {
        var index: int32 = 0;

        for row in quotients {
            if (row.left / row.right on_zero 7) != row.expected {
                return index;
            }

            index = index + 1;
        }

        return -1;
    }

    fn first_wrong_remainder() -> int32 {
        var index: int32 = 0;

        for row in remainders {
            if (row.left % row.right on_zero 7) != row.expected {
                return index;
            }

            index = index + 1;
        }

        return -1;
    }

    fn first_wrong_negation() -> int32 {
        var index: int32 = 0;

        for row in negations {
            if -row.operand != row.expected {
                return index;
            }

            index = index + 1;
        }

        return -1;
    }
}

