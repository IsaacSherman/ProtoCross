test SaturatingIntegerSweepInt64.first_wrong_negation "the int64 negation of every boundary value, clamped" {
    receiver {
        negations: [
            new SaturatingIntegerSweepInt64Negation { operand: -9223372036854775808, expected: 9223372036854775807 }, // 0
            new SaturatingIntegerSweepInt64Negation { operand: -9223372036854775807, expected: 9223372036854775807 }, // 1
            new SaturatingIntegerSweepInt64Negation { operand: -1, expected: 1 }, // 2
            new SaturatingIntegerSweepInt64Negation { operand: 0, expected: 0 }, // 3
            new SaturatingIntegerSweepInt64Negation { operand: 1, expected: -1 }, // 4
            new SaturatingIntegerSweepInt64Negation { operand: 9223372036854775806, expected: -9223372036854775806 }, // 5
            new SaturatingIntegerSweepInt64Negation { operand: 9223372036854775807, expected: -9223372036854775807 }, // 6
        ],
    }

    expect return -1;
}

