test SaturatingIntegerSweepInt32.first_wrong_negation "the int32 negation of every boundary value, clamped" {
    receiver {
        negations: [
            new SaturatingIntegerSweepInt32Negation { operand: -2147483648, expected: 2147483647 }, // 0
            new SaturatingIntegerSweepInt32Negation { operand: -2147483647, expected: 2147483647 }, // 1
            new SaturatingIntegerSweepInt32Negation { operand: -1, expected: 1 }, // 2
            new SaturatingIntegerSweepInt32Negation { operand: 0, expected: 0 }, // 3
            new SaturatingIntegerSweepInt32Negation { operand: 1, expected: -1 }, // 4
            new SaturatingIntegerSweepInt32Negation { operand: 2147483646, expected: -2147483646 }, // 5
            new SaturatingIntegerSweepInt32Negation { operand: 2147483647, expected: -2147483647 }, // 6
        ],
    }

    expect return -1;
}

