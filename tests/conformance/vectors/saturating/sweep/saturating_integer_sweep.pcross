test SaturatingIntegerSweepInt32.first_wrong_quotient "every int32 quotient of two boundary values, clamped, and the fallback for a zero divisor" {
    receiver {
        quotients: [
            new SaturatingIntegerSweepInt32Row { left: -2147483648, right: -2147483648, expected: 1 }, // 0
            new SaturatingIntegerSweepInt32Row { left: -2147483648, right: -2147483647, expected: 1 }, // 1
            new SaturatingIntegerSweepInt32Row { left: -2147483648, right: -1, expected: 2147483647 }, // 2
            new SaturatingIntegerSweepInt32Row { left: -2147483648, right: 0, expected: 7 }, // 3
